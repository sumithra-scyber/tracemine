# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Postgres connection string (async driver)
DATABASE_URL=postgresql+asyncpg://footprint:footprint@localhost:5432/footprint

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
SESSION_SECRET=replace-with-a-long-random-string

# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# LLM used only for ambiguous email classification (never sent full inbox)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6

# Days of inactivity before an account is flagged as a potential ghost
GHOST_INACTIVITY_DAYS=730
